{
  "name": "sakina-extension",
  "version": "0.3.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/fetch-model.mjs && node scripts/build.mjs",
    "zip": "node scripts/fetch-model.mjs && node scripts/build.mjs --zip",
    "test": "node --test test/*.test.mjs",
    "e2e": "node scripts/build.mjs && node test/e2e.mjs",
    "chrome": "node scripts/build.mjs && node scripts/chrome.mjs",
    "icons": "python3 scripts/make-icons.py",
    "fetch-model": "node scripts/fetch-model.mjs",
    "store:setup": "node scripts/publish-store.mjs setup",
    "store:status": "node scripts/publish-store.mjs status",
    "bump": "node scripts/publish-store.mjs bump",
    "release": "node scripts/publish-store.mjs"
  },
  "devDependencies": {
    "esbuild": "0.24.0",
    "onnxruntime-node": "^1.20.1"
  },
  "dependencies": {
    "@jitsi/rnnoise-wasm": "^0.2.1",
    "@tensorflow/tfjs": "4.22.0",
    "nsfwjs": "4.2.1",
    "onnxruntime-web": "^1.20.1"
  },
  "description": "Chrome extension: turns down music in YouTube videos (keeps voices and sound effects) and blurs 18+ scenes."
}
